# Runtime
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# PostgreSQL and Redis
DATABASE_URL=postgres://wa_gateway:change-me@127.0.0.1:5432/wa_gateway
REDIS_URL=redis://127.0.0.1:6379

# Storage
DATA_DIR=./data
PUBLIC_URL=
MEDIA_MAX_BYTES=67108864
MEDIA_RETENTION_DAYS=30

# Tenancy and security
PUBLIC_SIGNUP=true
ADMIN_SECRET=
TRUST_PROXY=false
CORS_ORIGINS=
RATE_LIMIT_MAX=300
DASHBOARD_SESSION_TTL_DAYS=7
# Kosong = true saat NODE_ENV=production, false untuk development.
COOKIE_SECURE=
ALLOW_PRIVATE_MEDIA_URLS=false
ALLOW_PRIVATE_WEBHOOKS=false
WEBHOOK_TIMEOUT_MS=10000

# WhatsApp session limits and pacing
WA_SEND_INTERVAL_MS=1500
MAX_SESSIONS_PER_TENANT=5
MAX_SESSIONS_TOTAL=20
SESSION_MAX_RECONNECT_DELAY_MS=30000

# Database migrations (disable if you run them separately)
AUTO_MIGRATE=true
